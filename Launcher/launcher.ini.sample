; Copy to "launcher.ini" in the project root (next to Launcher.cmd). All keys are optional.
; background   = Images\MyPicture.jpg   ; default: the first .jpg/.png/.bmp in Images\, else a generic background
; panel        = right                  ; game list on the right or left
; window_scale = 3                      ; window size of the games (x 256 x 192)
; fullscreen   = 0                      ; 1 = start the launcher fullscreen (F11 toggles)
