# ROMs and anything derived from them (never commit)
ROMs/
*.sms
*.gg
*.sav
*.automap
Games/*/generated/
Games/*/build*/
Games/*/saves/

# Logs, test output, personal settings
*.log
dispatch_manifest.txt
ps_qol.ini
gv_qol.ini
*.ppm
*.png
*.wav
*.ram
*.vram
*.cram
*.regs

# Separate repos and third-party tools/data (not ours)
Recomp/
Disasm/
Emulicious/
Masterlator/
Patchers/
# third-party programs (not part of the project; unused since Tools/apply_patch.py replaced FLIPS)
ExternalTools/
# old location of ROMs/Patches (moved 2026-11-15; ROMs/ is ignored as a whole)
ROMPatches/

# Build/tool leftovers
*.exe
*.o
__pycache__/
*.pyc

# Reference material from fan sites / sprite rips (the user's, not ours; ROM-derived art)
Meta/
Games/*/build_log.txt

# user bug reports (screenshots / recordings of the game)
Bugs/

# the user's own artwork: launcher background, game covers "(front)" and logos "(logo)" (never committed)
Images/

# launcher: local settings and build output
launcher.ini
Launcher/build/

# editor: VS Code workspace settings (CMake Tools writes absolute paths)
.vscode/

# our ROM patches: build output (background = the user ROM, patched ROM, patches)
Patches/*/build/
# WLA-DX build output (External/wla-dx = git submodule)
External/build/
